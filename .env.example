# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/meituan_recommendation

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka配置
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_USER_BEHAVIOR=user_behavior
KAFKA_TOPIC_DISH_FEATURE=dish_feature

# MongoDB配置
MONGO_URI=mongodb://localhost:27017/meituan_recommendation

# API配置
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/recommendation.log

# 数据处理配置
DATA_PROCESSING_BATCH_SIZE=1000
DATA_PROCESSING_TIMEOUT=300